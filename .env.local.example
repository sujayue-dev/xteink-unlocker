# Copy to .env.local and fill in. .env.local is gitignored.

# Apple notarization credentials
APPLE_ID=you@sofriendly.com
APPLE_PASSWORD=@keychain:AC_PASSWORD       # app-specific password, or @keychain:NAME
APPLE_TEAM_ID=2H66PPM438

# Tauri auto-update signing (optional — leave blank to skip update bundle signing)
# Generate with `npx tauri signer generate -w ~/.tauri/xteink-unlocker.key`
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
